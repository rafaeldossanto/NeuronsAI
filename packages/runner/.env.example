# Address of the NeuronsAI server (http(s):// or ws(s)://). The runner connects to its /runner path.
NEURONS_SERVER_URL=http://127.0.0.1:3100
# Token issued by the server for this runner (the server shows it once):
#   pnpm --filter @neurons/server runner:token create <name>
NEURONS_RUNNER_TOKEN=
# How this runner is named in the server's logs (default: this machine's name)
NEURONS_RUNNER_NAME=
# Path of the Claude Code executable. Empty: found automatically.
NEURONS_CLAUDE_BIN=
# The token travels on this connection, so anything but a local server must be https://.
# Set to true only to accept plain ws:// to another machine.
NEURONS_RUNNER_ALLOW_INSECURE=
