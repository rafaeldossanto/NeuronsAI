{
  "name": "@neurons/runner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "neurons-runner": "dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts"
  },
  "dependencies": {
    "@neurons/agent-runtimes": "workspace:*",
    "@neurons/graph-schema": "workspace:*",
    "@neurons/runner-protocol": "workspace:*",
    "ws": "8.22.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/ws": "8.18.2",
    "tsx": "4.23.15"
  }
}
