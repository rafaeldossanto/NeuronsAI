{
  "name": "@neurons/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e:claude": "tsx e2e/claude-two-terminals.ts",
    "demo": "tsx demo/api-demo.ts",
    "demo:triggers": "tsx demo/triggers-demo.ts",
    "openapi:emit": "tsx src/api/openapi/emit-cli.ts",
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/database/migrate-cli.ts",
    "runner:token": "tsx --env-file-if-exists=.env src/runners/runners-cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.4.0",
    "@electric-sql/pglite": "0.5.13",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-fastify": "12.3.2",
    "@nestjs/platform-ws": "12.3.2",
    "@nestjs/websockets": "12.3.2",
    "@neurons/agent-runtimes": "workspace:*",
    "@neurons/graph-schema": "workspace:*",
    "@neurons/runner": "workspace:*",
    "@neurons/runner-protocol": "workspace:*",
    "@neurons/tools": "workspace:*",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "openai": "7.47.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ws": "8.22.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.3.2",
    "@neurons/api-client": "workspace:*",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "^24.19.2",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "drizzle-kit": "0.31.11",
    "testcontainers": "12.2.1",
    "tsx": "4.23.15"
  },
  "exports": {
    ".": {
      "types": "./dist/embed.d.ts",
      "default": "./dist/embed.js"
    }
  }
}
