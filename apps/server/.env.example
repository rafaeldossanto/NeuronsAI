# Execution mode: api | worker | all (default: all)
NEURONS_MODE=all
# Address to listen on (default: 127.0.0.1). There is no login yet, so anything that is not a local
# address (127.x, ::1, localhost) also needs NEURONS_ALLOW_REMOTE=true.
NEURONS_HOST=
NEURONS_ALLOW_REMOTE=
# Port (default: 3100)
NEURONS_PORT=3100

# Guards (empty = default). Messages a run may exchange before it is stopped (default: 200)
NEURONS_RUN_MAX_MESSAGES=
# Messages in a row between the same two agents, with nobody else, before the run is stopped (default: 20)
NEURONS_PING_PONG_MESSAGES=
# Spending limit in US$ for a run that sets none (default: no limit)
NEURONS_RUN_BUDGET_USD=
# Milliseconds a stopping run waits for the last turn to report its usage (default: 4000)
NEURONS_USAGE_FLUSH_MS=

# Where the agents run (default: local):
#   local  - a runner embedded in this process; nothing else to set up
#   hybrid - runners connect to /runner with a token (pnpm --filter @neurons/server runner:token create <name>)
#   hosted - same as hybrid until the cloud phase
NEURONS_PROFILE=local
# Seconds a runner that lost its connection has to come back before its agents fail (default: 60)
NEURONS_RUNNER_GRACE_SEC=
# Seconds between heartbeats with a runner (3 missed close the connection) (default: 15)
NEURONS_RUNNER_HEARTBEAT_SEC=
# Seconds starting an agent waits for a runner to be connected (default: 30)
NEURONS_RUNNER_WAIT_SEC=

# Seconds an agent's ask waits for the answer (default: 120)
NEURONS_ASK_TIMEOUT_SEC=120

# Database: embedded (PGlite, nothing to install) or postgres (default: embedded)
NEURONS_DB=embedded
# Folder for the app's data; the embedded database lives in <folder>/db.
# Empty = %APPDATA%\NeuronsAI (Windows), ~/Library/Application Support/NeuronsAI (macOS),
# $XDG_DATA_HOME/neuronsai or ~/.local/share/neuronsai (Linux)
NEURONS_DATA_DIR=

# Postgres (only used when NEURONS_DB=postgres): either a full URL...
NEURONS_DB_URL=
# ...or the individual parts (used only when NEURONS_DB_URL is empty)
NEURONS_DB_HOST=
NEURONS_DB_PORT=5432
NEURONS_DB_USER=
NEURONS_DB_NAME=
NEURONS_DB_PASSWORD=

# Path of the Claude Code executable used by terminal agents. Empty: found automatically
# (PATH, installer folders and, on Windows, the CLI inside the Claude desktop app).
NEURONS_CLAUDE_BIN=

# 32 random bytes in base64. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
NEURONS_MASTER_KEY=
